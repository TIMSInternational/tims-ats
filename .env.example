# =============================================================================
# TIMS Platform — Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Auth ---
NEXTAUTH_SECRET=generate-a-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Two-factor (TOTP) enforcement for privileged roles (platform owners + super_admins).
# When 'true', those users must step up to a verified Supabase MFA factor (aal2)
# before any admin route loads. Default off — deploy first, enroll, then flip on.
MFA_ENFORCED=false
# Shared secret for the alert-evaluation Vercel Cron (/api/cron/evaluate-alerts).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. Unset ⇒ the route 401s.
CRON_SECRET=generate-a-random-secret

# --- AI (AWS Bedrock) ---
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
# Optional: Bedrock Guardrails (MASK PII server-side). Leave unset to disable.
# When set, every Bedrock call references this guardrail (defense-in-depth).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Email (AWS SES) ---
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@tims.com

# --- WhatsApp Business Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# --- Daily.co human video interviews ---
# Required for the staff interview room (`interview.createVideoRoom`). The API key
# is server-only; never expose it as NEXT_PUBLIC_*.
DAILY_API_KEY=your-daily-api-key
DAILY_API_URL=https://api.daily.co/v1

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Trigger.dev ---
TRIGGER_API_KEY=tr_dev_...
TRIGGER_API_URL=https://api.trigger.dev

# --- Sentry ---
SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# --- OpenSign ---
OPENSIGN_API_URL=http://localhost:3001
OPENSIGN_API_KEY=your-opensign-key

# --- Cloudflare Turnstile (CAPTCHA on the public careers apply form) ---
# Optional. When BOTH are set, the public applyToVacancy endpoint requires a valid
# Turnstile token (anti-spam/DoS). When unset, the captcha is skipped (dev default).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- C# Platform backend migration (FE read cutover, DARK by default) ---
# Base URL of the C# Platform service (services/Tims.Platform). NEXT_PUBLIC_* so the
# browser client can reach it. UNSET ⇒ the platform-api client is DISABLED and every
# read surface falls back to the existing tRPC path (byte-identical to today). Set only
# at cutover once the C# service is deployed.
NEXT_PUBLIC_TIMS_PLATFORM_API_URL=
# Per-surface flag: route the team-intelligence dashboard KPIs read to the C# service.
# Requires NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the
# exact string 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_TEAMINTEL_READ_VIA_CSHARP=false
# Per-surface flag: route ALL SIX recruitment-analytics reads (kpis / funnel /
# source-breakdown / trend / lost-by-delay / recruiter-sla) to the C# service. Mirrors the
# backend `Platform:ReportingReadEnabled` flag (one FE flag per backend domain flag).
# Requires NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact
# string 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_REPORTING_READ_VIA_CSHARP=false
# Per-surface flag: route the three billing reads (getBillingConfig / getCurrentPlan /
# getUsage) to the C# service. Mirrors the backend `Platform:BillingUsageEnabled` flag that
# gates all three routes. Requires NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything
# other than the exact string 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_BILLING_USAGE_VIA_CSHARP=false
# Per-surface flag: route the tenant invoice-history read (listInvoices / getInvoice) to the
# C# service. Mirrors the backend `Platform:BillingReadEnabled` flag (independent of
# BillingUsageEnabled above — cuts over on its own). Requires
# NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string
# 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_BILLING_INVOICES_VIA_CSHARP=false
# Per-surface flag: route ALL FIVE evaluation360 reads (listCycles / getCycleProgress /
# myRaterTasks / myReport / myReportCycles) to the C# service. Mirrors the backend
# `Platform:Evaluation360ReadEnabled` flag that gates all five routes. Requires
# NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string
# 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_EVALUATION360_READ_VIA_CSHARP=false

# Per-surface flag: route ALL EIGHT FE-consumed succession reads (getDashboardKpis /
# listCriticalRoles / getCompetencyCoverage / getFlightRisk / getRolesWithoutSuccessor /
# getCompGapAlerts / getSuggestedSuccessors / simulateExit) to the C# service. Mirrors the
# backend `Platform:SuccessionReadEnabled` flag that gates all nine routes. Requires
# NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string
# 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_SUCCESSION_READ_VIA_CSHARP=false

# RETIRED 2026-07-29 — DEAD FLAG, no code reads it. It used to route the FIVE FE-consumed FX-FREE
# compensation reads (getSalaryBands / getBenefitsUtilization / getCompaRatioDistribution /
# listPendingAdjustments / myCompensation) to the C# service. The flag was confirmed live in prod on
# 2026-07-28 and those five TS tRPC procedures were deleted on 2026-07-29, so the reads are now
# unconditionally C#-served (apps/web/lib/platform-api/compensation.ts no longer references this
# variable). Kept listed here only so the name is not mistaken for a missing flag — setting it has
# NO effect. NEXT_PUBLIC_COMPENSATION_WRITE_VIA_CSHARP (createAdjustment / approveAdjustment) was
# never listed in this file and is retired in exactly the same way. The FX flag below is the ONLY
# compensation FE flag still read by any code.
NEXT_PUBLIC_COMPENSATION_READ_VIA_CSHARP=false

# Per-surface flag, SEPARATE from the retired one above and the ONLY LIVE compensation FE flag:
# route the THREE FE-consumed FX-DEPENDENT compensation reads (getBandDistribution /
# getTotalCompBreakdown / getDashboardKpis) to the C#
# service. Mirrors the backend `Platform:FxReadsEnabled` flag — shared cross-domain with
# `dei.getPayEquity`'s backend gate (see NEXT_PUBLIC_DEI_READ_VIA_CSHARP below), so flip this
# only once `fx_rates` has been populated by the first FxRefreshJob run. getPayEquity
# (compensation's own) and simulateAdjustment have no FE call site and stay on tRPC. Requires
# NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string 'true'
# (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_COMPENSATION_FX_READ_VIA_CSHARP=false

# Per-surface flag: route the NINE FE-consumed DEI reads (getDashboardKpis /
# getGenderRepresentation / getAgeDistribution / getNationalityDiversity / getHiringFunnel /
# getPromotionEquity / getLeadershipDiversity / getInclusionIndex / getPayEquity) to the C#
# service. Mirrors the backend `Platform:DeiReadEnabled` flag (eight of the nine reads) AND
# `Platform:FxReadsEnabled` (getPayEquity alone, canaried independently) — flip both backend
# flags together before setting this. getEthnicityDistribution / getDisabilityDistribution have
# no FE call site and stay on tRPC. Requires NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set.
# Anything other than the exact string 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_DEI_READ_VIA_CSHARP=false

# Per-surface flag, SERVER-ONLY (deliberately NOT NEXT_PUBLIC_* — no browser is ever involved in
# this surface): route the external-vendor assessment reads (external.getAssessmentResults /
# external.getAssessmentResult) to the C# service. A third-party vendor calls these tRPC
# procedures directly with `Authorization: Bearer tims_...`; when this flag is on, the TS
# procedure forwards that SAME header to the C# service (services/Tims.Platform) instead of
# querying Prisma directly, so the vendor's key is re-authenticated independently by the C# side.
# Mirrors the backend `Platform:ExternalVendorReadEnabled` flag. Requires
# NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string 'true'
# (including unset) keeps the Prisma path. Default off.
EXTERNAL_VENDOR_READ_VIA_CSHARP=false

# Per-surface flag, SERVER-ONLY (same rationale as the read flag above): route the
# external-vendor validation WRITE (external.submitValidationResult) to the C# service. Mirrors
# the backend `Platform:ExternalVendorWriteEnabled` flag. Note: the STAFF write on the same
# table (offer.updateValidation) has NO FE consumer today (verified — zero call sites anywhere
# in apps/web), so it has no cutover wrapper here; per the table-ownership ledger, both writers
# must flip together for preemployment_validations to reach full `efcore` ownership, so that
# staff path needs a live UI before it can be part of any real cutover. Requires
# NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string 'true'
# (including unset) keeps the Prisma path. Default off.
EXTERNAL_VENDOR_WRITE_VIA_CSHARP=false

# Per-surface flag: route the cross-org audit-log surface (platform.getCrossOrgAuditLogs /
# exportAuditLogsCsv) to the C# service. Platform-owner-only (PlatformOwnerGate — no tenant RLS,
# a platform owner reads cross-org by design). Mirrors the backend `Platform:AuditLogReadEnabled`
# flag. Requires NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact
# string 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_AUDIT_LOG_READ_VIA_CSHARP=false

# Per-surface flag: route the SIX evaluation360 writes (createCycle / openCycle / closeCycle /
# publishCycle / assignRaters / submitRatings) to the C# service. Mirrors the backend
# `Platform:Evaluation360WriteEnabled` flag, SEPARATE from NEXT_PUBLIC_EVALUATION360_READ_VIA_CSHARP.
# Requires NEXT_PUBLIC_TIMS_PLATFORM_API_URL to also be set. Anything other than the exact string
# 'true' (including unset) keeps the tRPC path. Default off.
NEXT_PUBLIC_EVALUATION360_WRITE_VIA_CSHARP=false

# --- Row-Level Security enforcement ---
# When 'true', tenant routers run `SET LOCAL ROLE app_tenant` per query so Postgres RLS
# applies (DB-level tenant isolation). Requires the RLS migration applied + GRANT
# app_tenant TO postgres. App connects as postgres via the pooler (6543, ?pgbouncer=true).
RLS_ENFORCED=false
