<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Tims.Workers: the single-replica scheduler HOST (Phase 4 Slice 1). Refs Application +
       Infrastructure (pinned by ArchitectureTests). Runs Quartz + the resilient-job framework;
       emits no OpenAPI (unlike Tims.Api). Sdk.Web ⇒ executable — no <OutputType> needed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tims.Application\Tims.Application.csproj" />
    <ProjectReference Include="..\Tims.Infrastructure\Tims.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Quartz" Version="3.18.2" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
