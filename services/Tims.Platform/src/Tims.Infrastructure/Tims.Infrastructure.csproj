<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tims.Infrastructure: EF Core, Npgsql, Redis clients, the RLS TenantScope.
       Refs Application + Domain (allowed inward direction). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- WP3.1 HRIS: design-time EF tooling so `dotnet ef migrations` can build HrisDbContext (the
         first EF-OWNED product context). PrivateAssets=all keeps it out of the runtime/consumer
         surface (Api/Workers/tests never carry it). Pinned to the resolved EF Core 10.0.4. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- WP2.6 rate limiter: raw Redis (EVAL of the exact Upstash slidingWindow Lua) so buckets
         are SHARED with the TS @upstash/ratelimit stack. Pinned to the version the Api host
         already carries (3.0.17) for a single resolved graph. -->
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
    <!-- WP3.2 HRIS connector resilience: the OFFICIAL Microsoft Polly-v8 resilience stack on a typed
         HttpClient (timeout → retry+backoff+jitter on 429/5xx → circuit breaker). Pinned to 10.0.0,
         aligned to the .NET 10 shared framework (clean transitive graph: Resilience/ObjectPool/
         Http.Diagnostics 10.0.0). Brings Microsoft.Extensions.Http, so AddHttpClient is available. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tims.Application\Tims.Application.csproj" />
    <ProjectReference Include="..\Tims.Domain\Tims.Domain.csproj" />
  </ItemGroup>

  <!-- Test seams: the deterministic-clock constructors on the rate limiters are internal so they
       stay out of the production surface, but the WP2.6 tests drive them to pin bucket + weight. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tims.IntegrationTests" />
  </ItemGroup>

</Project>
