# Copy to terraform.tfvars and fill in. Secret VALUES are NOT here — they go to Secrets Manager
# out-of-band (see README). This file holds only non-secret config.

aws_region = "us-west-2" # MUST co-locate with the Supabase DB (#100)

# The image tag pushed to ECR in runbook §3 (e.g. the short git SHA).
image_tag = "REPLACE_WITH_PUSHED_TAG"

# Public Supabase auth config (NOT secret).
supabase_jwt_issuer            = "https://REPLACE_REF.supabase.co/auth/v1"
supabase_jwt_audience          = "authenticated"
supabase_jwks_metadata_address = "https://REPLACE_REF.supabase.co/auth/v1/.well-known/jwks.json"

# otlp_endpoint = "http://otel-collector:4317"   # optional

# First deploy: keep ALL flags false (a deploy activates NO strangled surface) — EXCEPT
# team_intel_read, see the ⚠️ below. Flip one at a time at cutover, AFTER setting the matching
# FE NEXT_PUBLIC_*_VIA_CSHARP flag.
#
# ⚠️⚠️⚠️ team_intel_read = true IS NOT A TYPO — DO NOT "FIX" IT BACK TO false ⚠️⚠️⚠️
# `Platform__TeamIntelReadEnabled` is CONFIRMED LIVE in real production as of 2026-07-27, flipped
# manually OUT-OF-BAND (not through this Terraform module — see the NOTICE at the top of main.tf
# and docs/architecture/csharp-migration/PROD-DEPLOY-RUNBOOK-gate-g3.md). This module has likely
# never been applied against the real App Runner service. If you copy this file to
# terraform.tfvars and run `terraform apply` for the first time WITHOUT first reconciling state
# (see main.tf's top-of-file NOTICE — you may need `terraform import` for the existing
# out-of-band service/secrets/IAM roles before this apply), you risk either a duplicate-resource
# error or SILENTLY REVERTING a live flag that real users already depend on. Leaving this at
# `true` here is the safety net; do not "clean it up" to match the other flags.
feature_flags = {
  # --- Already-wired surfaces (Gate G3 original 9) ---
  external_vendor_read   = false
  external_vendor_write  = false
  billing_read           = false
  billing_usage          = false
  billing_webhook_write  = false
  billing_self_serve     = false
  reporting_read         = false
  validation_staff_write = false
  team_intel_read        = true # CONFIRMED LIVE IN PROD (2026-07-27, out-of-band) — see ⚠️ above. DO NOT set to false.

  # --- 15 slices merged since the runbook was written at 9 dark surfaces ---
  evaluation360_read  = false
  succession_read     = false
  compensation_read   = false
  nine_box_read       = false
  engagement_read     = false
  dei_read            = false
  audit_log_read      = false
  fx_reads            = false
  compensation_write  = false
  evaluation360_write = false
  succession_write    = false
  nine_box_write      = false
  engagement_write    = false
  access_review_read  = false
  access_review_write = false

  # --- Q0b: the two surfaces that gate ownership flips #64/#66/#68 ---
  # ⚠️ BOTH of these env vars were previously ABSENT from main.tf entirely, so terraform never managed
  # them and an apply left whatever was set out-of-band untouched. They are managed now, which means an
  # apply WILL write these values. If either surface has been enabled out-of-band, set it true HERE
  # first or the apply silently darkens it — the same drift class as team_intel_read above.
  monitoring_read         = false # #100, Q0b slice 1 — the six monitoring READ endpoints
  alert_metrics_cron_read = false # #172, Q0b slice 2 — GET /internal/alert-metrics (cron cross-org read)
}

# #173 MFA step-up on the platform service. ⚠️ Also previously absent from main.tf, so the same
# apply-will-now-write warning applies. ONLY the exact string "true" enables it; anything else fails
# OPEN by design, so "" ships the gate inert. Set it to the SAME value as the web app's MFA_ENFORCED —
# a session refused by one stack and served by the other is the hole #173 exists to close.
mfa_enforced = ""

# ⚠️ Enabling alert_metrics_cron_read requires the secret to be populated FIRST:
#   aws secretsmanager put-secret-value \
#     --secret-id tims-platform-api/Platform__AlertMetricsCronSecret \
#     --secret-string "$(openssl rand -base64 48)"
# Terraform seeds every managed secret with the literal REPLACE_ME_OUT_OF_BAND so the ARN resolves.
# CronCallerGate REJECTS that literal (and anything under 32 chars) as unconfigured, so the surface
# stays 401 rather than accepting a credential that is committed to this repository. The same value
# must be set as ALERT_METRICS_CRON_SECRET in Vercel.

# Set true only before the billing WRITE cutover (creates + wires Stripe secret containers).
manage_stripe_secrets = false
