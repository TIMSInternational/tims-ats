<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <LangVersion>latest</LangVersion>

    <!-- The C# analog of TS-strict / no-any: analyzers on, code-style enforced at build,
         warnings are errors (above). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Deterministic, pinned restore: every project emits packages.lock.json (committed),
         and CI restores in locked mode so a drifted/typosquatted version fails the build
         rather than resolving silently (the NuGet analog of pnpm-lock + exact pins). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
