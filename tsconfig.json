{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@tims/db": ["packages/db/src/index.ts"],
      "@tims/api": ["packages/api/src/root.ts"],
      "@tims/shared": ["packages/shared/src/index.ts"],
      "@tims/ai": ["packages/ai/src/index.ts"],
      "@trpc/server": ["packages/api/node_modules/@trpc/server"],
      "@prisma/client": ["packages/api/node_modules/@prisma/client"]
    }
  },
  "exclude": ["node_modules"]
}
