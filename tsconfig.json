{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    // No "baseUrl": it is deprecated (TS 5.x deprecation notice; slated for removal in a future major).
    // Since TS 5.0 `paths` entries resolve relative to the tsconfig that
    // declares them, so the "./"-prefixed values below are repo-root-relative
    // exactly as they were under `baseUrl: "."`.
    "paths": {
      "@tims/db": ["./packages/db/src/index.ts"],
      "@tims/api": ["./packages/api/src/root.ts"],
      "@tims/shared": ["./packages/shared/src/index.ts"],
      "@tims/ai": ["./packages/ai/src/index.ts"],
      "@trpc/server": ["./packages/api/node_modules/@trpc/server"],
      "@prisma/client": ["./packages/api/node_modules/@prisma/client"],
      "exceljs": ["./packages/api/node_modules/exceljs"]
    }
  },
  "exclude": ["node_modules"]
}
