# C# API feature flags for the E2E stack (appended to the generated api.env by up.sh). Non-secret.
# Mirrors the flags live in production, plus the flags of UNMERGED PRs (#304 people directory,
# #307 tenant invitations, org-structure, assessment types): unknown flags are ignored by main, and
# pre-setting them means a merged PR only has to flip its test.fixme off (see e2e/README.md).
Platform__AccessReviewReadEnabled=true
Platform__AccessReviewWriteEnabled=true
Platform__AuditLogReadEnabled=true
Platform__BillingReadEnabled=true
Platform__BillingUsageEnabled=true
Platform__CompensationReadEnabled=true
Platform__CompensationWriteEnabled=true
Platform__DeiReadEnabled=true
Platform__EngagementReadEnabled=true
Platform__EngagementWriteEnabled=true
Platform__Evaluation360ReadEnabled=true
Platform__Evaluation360WriteEnabled=true
Platform__ExternalVendorReadEnabled=true
Platform__ExternalVendorWriteEnabled=true
Platform__FxReadsEnabled=true
Platform__NineBoxReadEnabled=true
Platform__NineBoxWriteEnabled=true
Platform__PlatformInvitationResendEnabled=true
Platform__PlatformUserInvitationCreateEnabled=true
Platform__ReportingReadEnabled=true
Platform__SuccessionReadEnabled=true
Platform__SuccessionWriteEnabled=true
Platform__TeamIntelReadEnabled=true
Platform__TenantInvitationsEnabled=true
Platform__TenantPeopleDirectoryEnabled=true
Platform__TenantOrgStructureEnabled=true
Platform__AssessmentTypeWriteEnabled=true
# #329 item 2: the C# API answers 503 to an ANONYMOUS relayed request (invitation setup, candidate join) whose
# signed relay attribution carries no client IP — the web relay vouches for one only on Vercel, and this stack's
# web app is not Vercel. This dev-only opt-out restores the old behaviour here (all such calls share the one
# `anonymous` bucket). The API container runs ASPNETCORE_ENVIRONMENT=Development; in Production the flag is
# refused unless TIMS_E2E_STACK=1 is also set (RelayAttributionMiddleware.AllowsAnonymousWithoutClientIp).
Platform__AllowAnonymousRelayWithoutClientIp=true
# The explicit E2E-stack marker (same name as the web side's, #336). Not needed while the container runs
# Development, but it keeps the opt-out valid if the stack ever runs the API as Production.
TIMS_E2E_STACK=1
