# Web (Next.js) C#-cutover flags for the E2E stack (appended to web.env by up.sh). Non-secret.
# Same policy as api-flags.env: production flags plus those of unmerged PRs, so enabling a spec
# after its PR merges is a one-line change.
NEXT_PUBLIC_INVITATION_RESEND_VIA_CSHARP=true
NEXT_PUBLIC_USER_INVITATION_CREATE_VIA_CSHARP=true
NEXT_PUBLIC_TENANT_INVITATIONS_VIA_CSHARP=true
NEXT_PUBLIC_TENANT_PEOPLE_DIRECTORY_VIA_CSHARP=true
NEXT_PUBLIC_TENANT_ORG_STRUCTURE_VIA_CSHARP=true
NEXT_PUBLIC_ASSESSMENT_TYPES_VIA_CSHARP=true
