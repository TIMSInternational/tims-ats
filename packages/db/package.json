{
  "name": "@tims/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema",
    "push": "bash ../../scripts/db/guard-prod-ddl.sh prisma db push --schema prisma/schema",
    "migrate": "bash ../../scripts/db/guard-prod-ddl.sh prisma migrate dev --schema prisma/schema",
    "studio": "prisma studio --schema prisma/schema",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "prisma": "^6.8.2",
    "typescript": "^5.8.0"
  }
}
