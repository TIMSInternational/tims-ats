model Candidate {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String
  phone           String?
  source          String
  poolType        String    @map("pool_type")
  avatar          String?
  location        String?
  currentTitle    String?   @map("current_title")
  currentCompany  String?   @map("current_company")
  yearsExperience Int?      @map("years_experience")
  education       Json?
  languages       Json?
  skills          Json?
  linkedinUrl     String?   @map("linkedin_url")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  createdBy              User?                  @relation("CandidateCreator", fields: [createdById], references: [id])
  applications           Application[]
  documents              CandidateDocument[]
  tags                   CandidateTag[]
  assessmentAssignments  AssessmentAssignment[]
  fitScores              FitScore[]
  interviews             Interview[]     @relation("CandidateInterviews")
  offers                 Offer[]         @relation("CandidateOffers")

  hirePredictions HirePrediction[]
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, poolType])
  @@index([createdById])
  @@map("candidates")
}

model CandidateDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  type           String
  fileName       String   @map("file_name")
  fileUrl        String   @map("file_url")
  fileSize       Int?     @map("file_size")
  parsedData     Json?    @map("parsed_data")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([organizationId])
  @@index([candidateId])
  @@map("candidate_documents")
}

model CandidateTag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  tag            String
  source         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([candidateId, tag])
  @@index([organizationId])
  @@map("candidate_tags")
}

model Referral {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  vacancyId      String    @map("vacancy_id") @db.Uuid
  referrerEmail  String    @map("referrer_email")
  referrerName   String?   @map("referrer_name")
  candidateEmail String    @map("candidate_email")
  token          String    @unique
  status         String    @default("pending")
  appliedAt      DateTime? @map("applied_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  vacancy        Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vacancyId])
  @@index([token])
  @@index([candidateEmail])
  @@map("referrals")
}
