model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  enabled        Boolean  @default(false)
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("feature_flags")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  changes        Json?
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user  User? @relation("AuditUser", fields: [userId], references: [id])
  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entity])
  @@index([organizationId, userId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// CB-2b — a recorded quarterly access recertification for one organization: a
// platform owner attested that the org's user↔role↔grant access was reviewed at a
// point in time (SOC 2 CC6.2–6.3 / ISO A.5.18 evidence). Org-scoped + RLS like every
// tenant table; written/read via the platform privileged path.
model AccessReview {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  reviewerId          String   @map("reviewer_id") @db.Uuid
  reviewedAt          DateTime @default(now()) @map("reviewed_at")
  userCount           Int      @map("user_count")
  privilegedCount     Int      @map("privileged_count")
  staleCount          Int      @map("stale_count")
  deprovisionGapCount Int      @map("deprovision_gap_count")
  expiredGapCount     Int      @map("expired_gap_count")
  notes               String?  @db.VarChar(2000)
  createdAt           DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("AccessReviewReviewer", fields: [reviewerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, reviewedAt])
  @@index([reviewerId])
  @@map("access_reviews")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
