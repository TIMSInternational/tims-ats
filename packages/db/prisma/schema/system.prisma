model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  enabled        Boolean  @default(false)
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("feature_flags")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  changes        Json?
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user  User? @relation("AuditUser", fields: [userId], references: [id])
  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entity])
  // #181: authz_denied / mfa_step_up_required rows are read BY ACTION (access review, incident
  // triage). Mirrors the (organizationId, entity) shape — org is the leading column because every
  // tenant-facing read of this table is org-scoped. Applied to prod by
  // migrations/20260810000000_audit_logs_action_index (CONCURRENTLY).
  @@index([organizationId, action])
  @@index([organizationId, userId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// CB-2b — `access_reviews` (a recorded quarterly access recertification per org; SOC 2
// CC6.2–6.3 / ISO A.5.18 evidence) was OWNERSHIP-FLIPPED to EF Core on 2026-08-03, the
// first flip executed under docs/architecture/csharp-migration/ownership-flip-runbook.md
// (#63/#65). The Prisma model was deleted here because the ledger forbids `@@map`'ing an
// `efcore[]` table — see docs/architecture/table-ownership.md.
//
// The table still EXISTS in production, unchanged. C# (AccessReviewDbContext) is now its
// sole reader, sole writer, and sole schema authority. Its DDL stays on the hand-applied
// SQL path (runbook §4 option (c)) — EF holds no migration and no snapshot for it.
// The original CREATE lives at
// packages/db/prisma/migrations/20260717170000_add_access_reviews/migration.sql.
//
// Do NOT re-add a model for this table. If you need to read it from TypeScript, call the
// C# API (apps/web/lib/platform-api/access-review.ts), do not reach into the database.

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
