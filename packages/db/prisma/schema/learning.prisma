model Course {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  description    String?
  type           String
  category       String?
  duration       Int
  content        Json?
  isRequired     Boolean  @default(false) @map("is_required")
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdBy   User?                @relation("CourseCreator", fields: [createdById], references: [id])
  enrollments Enrollment[]
  pathCourses LearningPathCourse[]

  @@index([organizationId])
  @@map("courses")
}

model LearningPath {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  description     String?
  targetGap       String?  @map("target_gap")
  isAutoGenerated Boolean  @default(false) @map("is_auto_generated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  courses LearningPathCourse[]

  @@index([organizationId])
  @@map("learning_paths")
}

model LearningPathCourse {
  id       String @id @default(uuid()) @db.Uuid
  pathId   String @map("path_id") @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  order    Int

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@map("learning_path_courses")
}

model Enrollment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  status         String
  progress       Float     @default(0)
  preTestScore   Float?    @map("pre_test_score")
  postTestScore  Float?    @map("post_test_score")
  enrolledAt     DateTime  @default(now()) @map("enrolled_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user        User         @relation("EnrollmentUser", fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  certificate Certificate?

  @@index([organizationId])
  @@map("enrollments")
}

model Certificate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  enrollmentId   String    @unique @map("enrollment_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  issuedAt       DateTime  @default(now()) @map("issued_at")
  expiresAt      DateTime? @map("expires_at")
  certificateUrl String?   @map("certificate_url")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  user       User       @relation("CertificateUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@map("certificates")
}
