model User {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  supabaseUserId   String    @unique @map("supabase_user_id")
  email            String
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  displayName      String?   @map("display_name")
  avatar           String?
  phone            String?
  jobTitle         String?   @map("job_title")
  companyId        String?   @map("company_id") @db.Uuid
  businessUnitId   String?   @map("business_unit_id") @db.Uuid
  locale           String    @default("es")
  timezone         String    @default("America/Bogota")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  isPlatformOwner  Boolean   @default(false) @map("is_platform_owner")
  lastLoginAt      DateTime? @map("last_login_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  setupChecklistDismissedAt DateTime? @map("setup_checklist_dismissed_at")

  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  teams            UserTeam[]
  ledTeams         Team[]      @relation("TeamLeader")
  auditLogs        AuditLog[]  @relation("AuditUser")
  createdAuditLogs AuditLog[]  @relation("AuditActor")
  // accessReviews removed 2026-08-03: `access_reviews` flipped to EF-owned (#63/#65). A
  // back-relation to a deleted model is a hard P1012. Read it via the C# API.
  createdVacancies Vacancy[]   @relation("VacancyCreator")
  assignedVacancies Vacancy[]  @relation("VacancyAssignee")
  vacancyApprovals VacancyApproval[] @relation("VacancyApprover")
  stageMovements   StageMovement[]   @relation("StageMovementActor")

  // Onboarding
  onboardingPlans          OnboardingPlan[]    @relation("OnboardingUser")
  buddyOnboardingPlans     OnboardingPlan[]    @relation("OnboardingBuddy")
  createdOnboardingPlans   OnboardingPlan[]    @relation("OnboardingCreator")
  completedOnboardingTasks OnboardingTask[]    @relation("OnboardingTaskCompletedBy")
  completedCheckIns        OnboardingCheckIn[] @relation("OnboardingCheckInCompletedBy")

  // Performance
  okrs                     Okr[]              @relation("OkrUser")
  createdOkrs              Okr[]              @relation("OkrCreator")
  coachingAsEmployee       CoachingSession[]  @relation("CoachingEmployee")
  coachingAsLeader         CoachingSession[]  @relation("CoachingLeader")
  commitments              Commitment[]       @relation("CommitmentEmployee")
  createdCommitments       Commitment[]       @relation("CommitmentCreator")
  feedbackGiven            Feedback[]         @relation("FeedbackFrom")
  feedbackReceived         Feedback[]         @relation("FeedbackTo")
  recognitionGiven         Recognition[]      @relation("RecognitionFrom")
  recognitionReceived      Recognition[]      @relation("RecognitionTo")

  // Monitoring
  createdAlertRules        AlertRule[]         @relation("AlertRuleCreator")
  dismissedAlerts          Alert[]             @relation("AlertDismisser")

  // Notifications
  notifications            Notification[]      @relation("UserNotifications")
  notificationPrefs        NotificationPreference? @relation("UserNotificationPrefs")

  // Integration
  createdConnectors        Connector[]         @relation("ConnectorCreator")
  createdWebhooks          Webhook[]           @relation("WebhookCreator")
  createdApiKeys           ApiKey[]            @relation("ApiKeyCreator")

  // Candidate
  createdCandidates        Candidate[]         @relation("CandidateCreator")

  // Invitations
  sentInvitations          PlatformInvitation[] @relation("InvitationSender")

  // Access control
  businessUnitAssignments  UserBusinessUnit[]

  // Assessment
  assessmentAssignments    AssessmentAssignment[] @relation("AssessmentAssigner")

  // Compensation
  employeeCompensations        EmployeeCompensation[]  @relation("EmployeeCompensationUser")
  salaryAdjustments            SalaryAdjustment[]      @relation("SalaryAdjustmentUser")
  salaryAdjustmentApprovals    SalaryAdjustment[]      @relation("SalaryAdjustmentApprover")
  salaryAdjustmentRequests     SalaryAdjustment[]      @relation("SalaryAdjustmentRequester")
  benefitEnrollments           BenefitEnrollment[]     @relation("BenefitEnrollmentUser")

  // Interview
  createdInterviews            Interview[]             @relation("InterviewCreator")
  interviewEvaluations         InterviewEvaluator[]    @relation("InterviewEvaluatorUser")
  interviewScorecards          InterviewScorecard[]    @relation("ScorecardEvaluator")

  // Offer
  createdOffers                Offer[]                 @relation("OfferCreator")
  offerApprovals               OfferApproval[]         @relation("OfferApprover")
  completedValidations         PreemploymentValidation[] @relation("ValidationCompletedBy")
  completedLegalChecks         LegalCheck[]            @relation("LegalCheckCompletedBy")

  // Succession — back-relations REMOVED by the ownership flip (#69, 2026-08-04).
  // critical_roles + successors are now `efcore` (C# is the sole writer); their Prisma models are
  // deleted, so criticalRolesHeld / successorEntries / addedSuccessors cannot exist here. A surviving
  // back-relation to a deleted model is a hard P1012 that the ledger check does NOT catch.

  // Engagement
  createdSurveys               Survey[]                @relation("SurveyCreator")
  surveyResponses              SurveyResponse[]        @relation("SurveyResponseUser")
  actionPlans                  ActionPlan[]            @relation("ActionPlanResponsible")
  leaderCommitments            LeaderCommitment[]      @relation("LeaderCommitmentLeader")

  // Learning
  createdCourses               Course[]                @relation("CourseCreator")
  enrollments                  Enrollment[]            @relation("EnrollmentUser")
  certificates                 Certificate[]           @relation("CertificateUser")

  // Nine Box
  nineBoxEvaluations           NineBoxEvaluation[]     @relation("NineBoxUser")
  // The four calibration back-relations (calibrationSessionsCreated, calibrationMemberships,
  // calibrationEvaluated, calibrationVotes) were removed by ownership flip #70 — the three
  // Calibration* models are gone and a surviving back-reference is a hard P1012. The FKs
  // calibration_sessions.created_by_id / calibration_members.user_id /
  // calibration_votes.{evaluated_user_id,voter_id} → users(id) still exist in the database; they are
  // declared in services/Tims.Platform/db/flip-ddl/calibration.sql, not here.

  // Demographics (1:1, sensitive self-ID — see employee.prisma)
  demographics                 EmployeeDemographics?

  // 360 Evaluation (Sprint 1.7)
  // The three back-relations (reviewCyclesCreated, raterAssignmentsAsSubject,
  // raterAssignmentsAsRater) were removed by ownership flip #67 — the three ReviewCycle/Rater*
  // models are gone and a surviving back-reference is a hard P1012. The FKs
  // review_cycles.created_by_id / rater_assignments.{subject_user_id,rater_user_id} → users(id)
  // still exist in the database; they are declared in
  // services/Tims.Platform/db/flip-ddl/evaluation360.sql, not here.

  hirePredictions      HirePrediction[] @relation("HirePredictionSubject")
  hirePredictionsHired HirePrediction[] @relation("HirePredictionHiredBy")
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([supabaseUserId])
  @@index([companyId])
  @@index([businessUnitId])
  @@map("users")
}

model UserTeam {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("user_teams")
}
