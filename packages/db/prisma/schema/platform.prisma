model PlatformOwnerEmail {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_owner_emails")
}

enum InvitationType {
  org_admin
  user
}

enum InvitationStatus {
  pending
  sent
  accepted
  expired
  revoked
}

model PlatformInvitation {
  id                String           @id @default(uuid()) @db.Uuid
  email             String
  type              InvitationType
  organizationId    String?          @map("organization_id") @db.Uuid
  organizationName  String?          @map("organization_name")
  organizationSlug  String?          @map("organization_slug")
  organizationPlan  String?          @map("organization_plan")
  roleSlug          String?          @map("role_slug")
  token             String           @unique @default(uuid())
  status            InvitationStatus @default(pending)
  invitedById       String           @map("invited_by_id") @db.Uuid
  sentAt            DateTime? @map("sent_at")
  acceptedAt        DateTime? @map("accepted_at")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@index([invitedById])
  @@map("platform_invitations")
}
