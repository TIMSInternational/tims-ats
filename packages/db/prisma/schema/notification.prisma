model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    // critical, warning, info, success
  title          String
  message        String?
  module         String?   // vacancy, pipeline, interview, onboarding, etc.
  entityType     String?   @map("entity_type") // vacancy, candidate, interview, etc.
  entityId       String?   @map("entity_id") @db.Uuid
  actionUrl      String?   @map("action_url")
  read           Boolean   @default(false)
  readAt         DateTime? @map("read_at")
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  categories      Json     @default("{\"critical\":true,\"warning\":true,\"info\":true,\"success\":true}")
  modules         Json     @default("{}")
  quietHoursStart String?  @map("quiet_hours_start")
  quietHoursEnd   String?  @map("quiet_hours_end")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation("UserNotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
