model Connector {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  type            String
  status          String    @default("disconnected")
  config          Json
  lastSyncAt      DateTime? @map("last_sync_at")
  syncFrequency   String?   @map("sync_frequency")
  entitiesSynced  Int       @default(0) @map("entities_synced")
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator User            @relation("ConnectorCreator", fields: [createdById], references: [id])
  syncs   ConnectorSync[]
  errors  SyncError[]

  @@index([organizationId])
  @@map("connectors")
}

model ConnectorSync {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  connectorId       String    @map("connector_id") @db.Uuid
  status            String
  entitiesProcessed Int       @default(0) @map("entities_processed")
  duration          Int?
  error             String?
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("connector_syncs")
}

model SyncError {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  connectorId    String    @map("connector_id") @db.Uuid
  errorType      String    @map("error_type")
  message        String
  details        Json?
  retryCount     Int       @default(0) @map("retry_count")
  status         String    @default("pending")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sync_errors")
}

model Webhook {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  url             String
  events          Json
  secret          String?
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  failureCount    Int       @default(0) @map("failure_count")
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator User @relation("WebhookCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("webhooks")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyHash        String    @map("key_hash")
  keyPrefix      String    @map("key_prefix")
  environment    String    @default("production")
  scopes         Json
  lastUsedAt     DateTime? @map("last_used_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  creator User @relation("ApiKeyCreator", fields: [createdById], references: [id])

  @@index([keyHash])
  @@index([organizationId])
  @@map("api_keys")
}
