datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum OrgPlan {
  trial
  starter
  professional
  enterprise
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  domain      String?  @unique
  logo        String?
  plan        OrgPlan  @default(trial)
  settings    Json     @default("{}")
  billingEmail String? @map("billing_email")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  companies     Company[]
  users         User[]
  roles         Role[]
  featureFlags       FeatureFlag[]
  auditLogs          AuditLog[]
  vacancies          Vacancy[]
  subscription       Subscription?
  invoices           Invoice[]
  billingProfile     BillingProfile?
  invitations        PlatformInvitation[]
  aiAgentOrgConfigs  AiAgentOrgConfig[]
  offers             Offer[]            @relation("OrganizationOffers")

  @@map("organizations")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  country        String
  currency       String   @default("USD")
  timezone       String   @default("America/Bogota")
  language       String   @default("es")
  legalName      String?  @map("legal_name")
  taxId          String?  @map("tax_id")
  settings       Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnits  BusinessUnit[]
  vacancies      Vacancy[]

  @@index([organizationId])
  @@map("companies")
}

model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  code           String?
  parentId       String?  @map("parent_id") @db.Uuid
  settings       Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent         BusinessUnit? @relation("UnitHierarchy", fields: [parentId], references: [id])
  children       BusinessUnit[] @relation("UnitHierarchy")
  teams          Team[]
  vacancies      Vacancy[]

  @@index([organizationId])
  @@index([companyId])
  @@index([parentId])
  @@map("business_units")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessUnitId String   @map("business_unit_id") @db.Uuid
  name           String
  leaderId       String?  @map("leader_id") @db.Uuid
  settings       Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  leader         User?        @relation("TeamLeader", fields: [leaderId], references: [id])
  members        UserTeam[]
  vacancies      Vacancy[]
  okrs           Okr[]

  @@index([organizationId])
  @@index([businessUnitId])
  @@index([leaderId])
  @@map("teams")
}
