{
  "name": "tims-ats",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @tims/db generate",
    "db:push": "pnpm --filter @tims/db push",
    "db:migrate": "pnpm --filter @tims/db migrate",
    "db:studio": "pnpm --filter @tims/db studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.106.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.90.0",
    "@daily-co/daily-react": "^0.25.2"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.1"
    }
  }
}
