{
  "$comment": "Frozen cross-stack contract for the shared DynamoDB rate-limit store. Both stacks test against this file: packages/api/src/middleware/rate-limit-store.ts (TS) and Tims.Infrastructure.RateLimiting.DynamoDbRateLimitStore (C#). Change it only in lockstep on both stacks.",
  "table": {
    "partitionKey": "pk",
    "ttlAttribute": "expiresAt"
  },
  "slidingWindow": {
    "partitionKeyFormat": "rl#{category}#{lowercase hex sha256(utf8 identifier)}",
    "windowAttributeFormat": "w{bucket}",
    "bucket": "floor(nowMs / windowMs)",
    "expiresAtSeconds": "ceil((bucket + 2) * windowMs / 1000) + 60",
    "updateExpression": "ADD #cur :one SET #e = :exp",
    "removeClauseFormat": " REMOVE #old0, #old1, ...",
    "conditionWithPrevious": "(attribute_not_exists(#cur) OR #cur < :max) AND #prev = :prevSeen AND attribute_not_exists(#next)",
    "conditionWithoutPrevious": "(attribute_not_exists(#cur) OR #cur < :max) AND attribute_not_exists(#prev) AND attribute_not_exists(#next)",
    "attempts": 3,
    "contentionRetryMs": 1000
  },
  "budgets": {
    "$comment": "Tokens per sliding window, per category. Both stacks must use the same numbers or one caller would get a different budget from each. query was raised from 100 to 300 on 2026-10-23, when the shared limit first applied across all instances and both stacks.",
    "mutation": { "tokens": 30, "windowMs": 60000 },
    "query": { "tokens": 300, "windowMs": 60000 },
    "auth": { "tokens": 10, "windowMs": 300000 },
    "ai": { "tokens": 10, "windowMs": 60000 },
    "export": { "tokens": 5, "windowMs": 300000 }
  },
  "claim": {
    "conditionExpression": "attribute_not_exists(pk) OR #e <= :now",
    "prefixes": {
      "applicationEmail": "ae#",
      "relayNonce": "relay#"
    }
  },
