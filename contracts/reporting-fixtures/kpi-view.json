          {
            "slaHours": 48,
            "rejectedAtMs": 432000000,
            "appliedAtMs": 0,
            "lastMovedAtMs": 86400000
          },
          {
            "slaHours": 48,
            "rejectedAtMs": 172800000,
            "appliedAtMs": 0,
            "lastMovedAtMs": null
          },
          {
            "slaHours": null,
