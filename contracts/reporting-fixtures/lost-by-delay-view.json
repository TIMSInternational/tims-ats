            "stageName": "Screen",
            "slaHours": 48,
            "appliedAtMs": 0,
            "lastMovedAtMs": 86400000,
            "rejectedAtMs": 432000000
          },
          {
            "stageName": "Offer",
            "slaHours": 24,
            "appliedAtMs": 0,
            "lastMovedAtMs": null,
            "rejectedAtMs": 172800000
          }
        ]
      },
      "expected": {
        "total": 3,
        "items": [
          {
            "stageName": "Screen",
            "slaDays": 2,
            "lostCount": 2,
            "avgDaysOver": 2
          },
          {
            "stageName": "Offer",
            "slaDays": 1,
            "lostCount": 1,
            "avgDaysOver": 1
          }
        ]
      }
    },
    {
      "name": "boundary (hours == sla NOT counted); null sla / null rejectedAt skipped",
