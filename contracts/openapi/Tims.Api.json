  "components": {
    "schemas": {
      "BillingConfigV1": {
        "required": [
          "configured"
        ],
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          }
        }
      },
      "CheckoutSessionBody": {
        "required": [
          "plan"
        ],
        "type": "object",
        "properties": {
          "plan": {
            "type": "string"
          }
        }
      },
      "ExternalAssessmentResultV1": {
        "required": [
          "schemaVersion",
          "assignmentId",
          "candidateId",
          "vacancyId",
          "assessmentType",
          "status",
          "assignedAt",
          "startedAt",
          "completedAt",
          "expiresAt",
          "scoredAt",
          "rawScore",
          "normalizedScore",
          "percentile",
          "interpretation",
          "breakdown",
          "modelVersion"
        ],
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string"
          },
          "assignmentId": {
            "type": "string"
          },
          "candidateId": {
            "type": "string"
          },
          "vacancyId": {
            "type": "string"
          },
          "assessmentType": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "string"
          },
          "assignedAt": {
            "format": "date-time"
          },
          "startedAt": {
            "format": "date-time"
          },
          "completedAt": {
            "format": "date-time"
          },
          "expiresAt": {
            "format": "date-time"
          },
          "scoredAt": {
            "format": "date-time"
          },
          "rawScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "normalizedScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "percentile": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "interpretation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonNode"
              }
            ]
          },
          "breakdown": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonNode"
              }
            ]
          },
          "modelVersion": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExternalValidationResultV1": {
        "required": [
          "schemaVersion",
          "id",
          "status",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "completedAt": {
            "format": "date-time"
          }
        }
      },
      "FunnelStageView": {
        "required": [
          "name",
          "count",
          "pctOfMax"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pctOfMax": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "FunnelView": {
        "required": [
          "stages",
          "totalApplications",
          "totalHired",
          "conversionPct"
        ],
        "type": "object",
        "properties": {
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FunnelStageView"
            }
          },
          "totalApplications": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalHired": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "conversionPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "InvoiceDetailV1": {
        "required": [
          "subscription",
          "id",
          "invoiceNumber",
          "organizationId",
          "subscriptionId",
          "stripeInvoiceId",
          "amount",
          "subtotal",
          "taxRate",
          "currency",
          "status",
          "description",
          "invoiceDate",
          "dueDate",
          "poNumber",
          "notes",
          "memo",
          "emailTo",
          "emailCc",
          "paidAt",
          "invoiceUrl",
          "periodStart",
          "periodEnd",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "subscription": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SubscriptionV1"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "invoiceNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "organizationId": {
            "type": "string"
          },
          "subscriptionId": {
            "type": [
              "null",
              "string"
            ]
          },
          "stripeInvoiceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "subtotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
